! laminar Poiseuille flow with five passive scalars; steady exact solutions (check data/stats.dat):
!   S1, S2 : uniform source 1, S = 0 at the walls  ->  S = Re*Pr/2 (1 - y^2) = 2.5 (1 - y^2)
!   S3, S4 : dS/dy = 0.5 at y = -1, S = 0 at y = 1 ->  S = 0.5 (y - 1)
!   S5     : dS/dy = 0.2 at both walls             ->  S = 0.2 y
! S1, S3 implicit (Crank-Nicolson), S2, S4 explicit RK3, S5 fully implicit (theta = 1).
! The log (data/log.dat) shows the wall gradients (last 10 columns): -5,5 | -5,5 | 0.5,0.5 | 0.5,0.5 | 0.2,0.2
&grid nx=4, ny=33, nz=4, lx=6.283185307179586, lz=3.141592653589793, grid_type='tanh', grid_alpha=2.0, fd_order=6 /
&physics re=100., forcing='cfr', ubulk=1.0 /
&time nstep=10000000, tmax=400., cfl=1.0, cfl_visc=1.5 /
&init init_type='laminar' /
&output iout_log=2000, iout_stats=10, iout_save_stats=100000, iout_restart=0, tstats_start=390. /
&scalars nscal=5, pr=0.05,0.05,0.05,0.05,0.1, scal_theta=0.5,0.0,0.5,0.0,1.0,
 sbc_bot='D','D','N','N','N', sbc_top='D','D','D','D','N', sval_bot=0.,0.,0.5,0.5,0.2, sval_top=0.,0.,0.,0.,0.2,
 ssrc_const=1.,1.,0.,0.,0., ssrc_u=0.,0.,0.,0.,0., sinit='zero','zero','zero','zero','zero' /
&parallel pdims=0,0 /
