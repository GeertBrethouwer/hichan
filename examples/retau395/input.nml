!======================================================================================================
!  Turbulent channel flow at Re_tau ~ 395 as in Sec. 5.3 of Lenaers et al. (2014):
!  Re_b = 6875, box 2pi x pi, 256 x 193 x 192, tanh grid alpha_s = 4 (dy+ = 0.62 ... 8.5)
!  Two passive scalars (Pr = 0.71 and 0.025) with uniform-heat-flux-type sources.
!  Restart from a Re_tau = 180 field or start from noise (transition takes ~100-200 h/U_b).
!======================================================================================================
&grid
  nx = 256, nz = 192, ny = 193
  lx = 6.283185307179586, lz = 3.141592653589793
  grid_type = 'tanh', grid_alpha = 4.0, fd_order = 6
/
&physics
  re = 6875., forcing = 'cfr', ubulk = 1.0
  nl_form = 'rotational', visc_theta = 0.0
/
&time
  nstep = 1000000, tmax = 1500., wall_time_max = 85000., cfl = 1.2, cfl_visc = 1.5
/
&init
  init_type = 'noise', init_amp = 0.25
/
&output
  iout_log = 100, iout_stats = 20, iout_save_stats = 5000, iout_restart = 10000, tstats_start = 500.
/
&scalars
  nscal = 2
  pr(1) = 0.71,  sval_bot(1) = 0.0, sval_top(1) = 0.0, ssrc_u(1) = 1.0, sinit(1) = 'zero'
  pr(2) = 0.025, sval_bot(2) = 0.0, sval_top(2) = 0.0, ssrc_u(2) = 1.0, sinit(2) = 'zero'
  scal_theta(2) = 0.5                  ! low Pr: implicit diffusion is essential
/
&buoyancy
  ri(1) = 0.0, ri(2) = 0.0
/
&parallel
  pdims = 0, 0, cudecomp_enable_nccl = .true., cudecomp_enable_nvshmem = .false.
/
