!======================================================================================================
!  Turbulent channel flow at Re_tau ~ 180 (Re_b = U_b h/nu = 2800, constant flow rate), box 4pi x 4pi/3
!  as Moser, Kim & Mansour (1999); two passive scalars. All items: see ../input_reference.nml
!  dx+ = 17.7, dz+ = 5.9 (before dealiasing), dy+ = 0.86 (wall) ... 4.7 (centre)
!======================================================================================================
&grid
  nx = 128, nz = 128, ny = 129         ! Fourier modes in x and z, grid points in y
  lx = 12.566370614359172              ! 4*pi
  lz = 4.1887902047863905              ! 4*pi/3
  grid_type = 'tanh', grid_alpha = 3.0 ! wall-clustered grid
  fd_order  = 6                        ! (3-5-6-5-3) compact scheme
/
&physics
  re         = 2800.                   ! bulk Reynolds number
  forcing    = 'cfr', ubulk = 1.0      ! constant flow rate
  nl_form    = 'rotational'
  visc_theta = 0.0                     ! explicit viscous terms (0.5: implicit, Appendix B.2)
/
&time
  nstep = 200000, tmax = 1500.
  wall_time_max = 85000.               ! seconds; leaves time for the final restart file
  cfl = 1.2, cfl_visc = 1.5
/
&init
  init_type = 'noise', init_amp = 0.25 ! laminar profile + 25% rms perturbations -> transition
/
&output
  iout_log = 100, iout_stats = 20, iout_save_stats = 5000, iout_restart = 10000
  tstats_start = 300.                  ! discard the transition
/
&scalars
  nscal = 2
  ! scalar 1: Pr = 0.71, s = +1 / -1 at the bottom / top wall
  pr(1) = 0.71, sbc_bot(1) = 'D', sval_bot(1) = 1.0, sbc_top(1) = 'D', sval_top(1) = -1.0, sinit(1) = 'linear'
  ! scalar 2: Pr = 0.71, uniform-heat-flux type (source u/U_b), s = 0 at both walls
  pr(2) = 0.71, sbc_bot(2) = 'D', sval_bot(2) = 0.0, sbc_top(2) = 'D', sval_top(2) = 0.0
  ssrc_u(2) = 1.0, sinit(2) = 'zero'
/
&buoyancy
  ri(1) = 0.0, ri(2) = 0.0             ! both scalars passive
/
&parallel
  pdims = 0, 0                         ! automatic / cuDecomp autotuning
  cudecomp_enable_nccl = .true., cudecomp_enable_nvshmem = .false.
/
